# Copy to .env and adjust for your host.
# Docker Compose reads this file automatically; scripts/podman_run.sh sources it.

# Hugging Face model to serve.
# Open model (recommended default):
MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# Alternatives:
# MODEL_ID=stabilityai/stable-diffusion-3.5-medium
# MODEL_ID=stabilityai/stable-diffusion-3.5-large

# vLLM OpenAI-compatible API port.
PORT=8091

# Tensor parallelism. 1 is enough for SDXL; increase only with multiple GPUs.
TP_SIZE=1

# Reduce VAE decode memory. Recommended on cards with <= 24 GB VRAM.
VAE_USE_SLICING=1
VAE_USE_TILING=1

# Required only for gated checkpoints (SD 3.5 family) or if you hit rate limits.
# Never commit this value.
HF_TOKEN=

# Console script used by scripts/start_server.sh. vllm-omni provides --omni;
# upstream vllm does not. Override only for a compatible custom install.
# VLLM_BIN=vllm-omni

# Optional: extra flags appended to `vllm-omni serve`, e.g.
# EXTRA_VLLM_ARGS=--enable-cpu-offload --disable-log-requests
EXTRA_VLLM_ARGS=

# Used by the Gradio UI.
API_BASE=http://127.0.0.1:8091
GRADIO_SERVER_PORT=7860

# Podman CLI options (scripts/podman_run.sh). Uncomment to override.
# IMAGE=sd-vllm:0.32.0
# CONTAINER_NAME=sd-vllm-server
# VOLUME_NAME=sd-vllm-hf-cache
# GPU_ARGS=--device nvidia.com/gpu=all
# BIND_ADDRESS=127.0.0.1
# Add :Z on SELinux-enforcing hosts for the outputs bind mount.
# OUTPUTS_VOLUME_OPT=:Z
